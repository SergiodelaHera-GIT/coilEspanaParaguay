    {
        "id": "1f30c8036b172cef",
        "type": "function",
        "z": "eb77ea0fe8cb6e59",
        "name": "ESTADOS INICIALES",
        "func": "// Define los tópicos de MQTT y los valores iniciales para toda la casa\nvar estados = [\n    // --- LUCES ---\n    { topic: \"casa/cocina/luz\", payload: \"OFF\" },\n    { topic: \"casa/hab1/luz\", payload: \"OFF\" },\n    { topic: \"casa/hab2/luz\", payload: \"OFF\" },\n    { topic: \"casa/hab3/luz\", payload: \"OFF\" },\n    { topic: \"casa/bano1/luz\", payload: \"OFF\" },\n    { topic: \"casa/bano2/luz\", payload: \"OFF\" },\n    { topic: \"casa/lavadora/luz\", payload: \"OFF\" },\n    { topic: \"casa/pasillo/luz\", payload: \"OFF\" },\n    \n    // --- PERSIANAS ---\n    { topic: \"casa/hab1/persiana\", payload: \"closed\" },\n    { topic: \"casa/hab2/persiana\", payload: \"closed\" },\n    { topic: \"casa/hab3/persiana\", payload: \"closed\" },\n\n    // --- SWITCHES ---\n    { topic: \"casa/salon/reposapies\", payload: \"OFF\" },\n    { topic: \"casa/salon/tv\", payload: \"OFF\" },\n    { topic: \"casa/salon/altavoces\", payload: \"OFF\" },\n    { topic: \"casa/bano1/grifo\", payload: \"OFF\" },\n    { topic: \"casa/bano2/grifo\", payload: \"OFF\" },\n\n    // --- SENSORES BINARIOS ---\n    { topic: \"casa/pasillo/movimiento\", payload: \"OFF\" },\n    { topic: \"casa/cocina/movimiento\", payload: \"OFF\" },\n    { topic: \"casa/bano1/manos\", payload: \"OFF\" },\n    { topic: \"casa/bano2/manos\", payload: \"OFF\" },\n    { topic: \"casa/salon/ventana\", payload: \"OFF\" },\n\n    // --- CLIMA ---\n    { topic: \"casa/salon/clima/modo\", payload: \"auto\" },\n    { topic: \"casa/salon/clima/consigna\", payload: \"21\" },\n    { topic: \"casa/salon/clima/temperatura\", payload: \"20.5\" },\n    { topic: \"casa/salon/clima/accion\", payload: \"idle\" }\n];\n\n// Genera un mensaje individual para cada estado con retain para Home Assistant\nreturn [estados.map(function(item) {\n    return {\n        topic: item.topic,\n        payload: item.payload,\n        retain: true\n    };\n})];",
