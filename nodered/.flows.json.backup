        "name": "DEJA PASAR SI HORA ENTRE 21:00 y 00:00",
        "func": "// FRANJA 21-00h\n// Deja pasar el movimiento solo si es de 21:00 a 00:00.\n// La variable global reloj_tenue la mantiene RELOJ VIRTUAL.\nif (global.get('reloj_tenue') === true) {\n    node.status({ fill: 'green', shape: 'dot', text: 'de noche: pasa' });\n    return msg;\n}\n\nnode.status({ fill: 'grey', shape: 'ring', text: 'de dia: ignorado' });\nreturn null;",
