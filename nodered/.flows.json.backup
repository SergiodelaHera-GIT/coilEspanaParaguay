    {
        "id": "feb66345dc5d50d3",
        "type": "function",
        "z": "eb77ea0fe8cb6e59",
        "name": "CONTROLES RELOJ",
        "func": "// CONTROL RELOJ\n// Fija el modo del reloj (real / simulado) y el salto de hora.\n// Guarda en las variables globales que lee RELOJ VIRTUAL:\n//   reloj_modo   -> 'real' | 'simulado'\n//   reloj_offset -> diferencia en ms respecto a la hora real\nconst p = String(msg.payload).trim();\n\nif (p === 'real') {\n    global.set('reloj_modo', 'real');\n    global.set('reloj_offset', 0);\n    node.status({ fill: 'blue', shape: 'dot', text: 'hora REAL' });\n\n} else if (p === 'simulado') {\n    global.set('reloj_modo', 'simulado');\n    // el offset se mantiene (si aun no hay salto, vale 0 y la hora sigue igual)\n    if (global.get('reloj_offset') === undefined) global.set('reloj_offset', 0);\n    node.status({ fill: 'green', shape: 'dot', text: 'hora SIMULADA' });\n\n} else if (/^\\d{2}:\\d{2}:\\d{2}$/.test(p)) {\n    const [h, m, s] = p.split(':').map(Number);\n    const ahora = new Date();\n    const objetivo = new Date(ahora.getFullYear(), ahora.getMonth(), ahora.getDate(), h, m, s).getTime();\n    global.set('reloj_modo', 'simulado');\n    global.set('reloj_offset', objetivo - ahora.getTime());\n    node.status({ fill: 'green', shape: 'dot', text: 'salto a ' + p });\n\n} else {\n    node.warn('Payload no reconocido: ' + p);\n}\n\nreturn null;",
        "outputs": 0,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 460,
        "wires": []
    },
