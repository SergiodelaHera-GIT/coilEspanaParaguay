        "name": "APAGAR 8 LUCES (00:00)",
        "func": "// APAGAR 8 LUCES\n// Manda OFF a las 8 luces. Un solo array por una salida = 8 mensajes seguidos.\nconst zonas = ['cocina', 'hab1', 'hab2', 'hab3', 'bano1', 'bano2', 'lavadora', 'pasillo'];\n\nreturn [zonas.map(z => ({\n    topic: 'casa/' + z + '/luz/set',\n    payload: 'OFF'\n}))];",
