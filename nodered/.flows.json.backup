    {
        "id": "983431203d6ea2e9",
        "type": "switch",
        "z": "eb77ea0fe8cb6e59",
        "name": "acaba en /set",
        "property": "topic",
        "propertyType": "msg",
        "rules": [
            {
                "t": "regex",
                "v": "^(?!casa/salon/clima/modo/set$).*/set$",
                "vt": "str",
                "case": false
            }
