    {
        "id": "c8d99fc421d33c47",
        "type": "function",
        "z": "eb77ea0fe8cb6e59",
        "name": "RELOJ VIRTUAL (para simulación)",
        "func": "// RELOJ VIRTUAL\n// Variables globales que fijará más adelante el nodo CONTROL RELOJ:\n//   reloj_modo   -> 'real' | 'simulado'\n//   reloj_offset -> diferencia en ms respecto a la hora real (solo en modo simulado)\n// Si no existen todavía, funciona en hora real.\nconst modo = global.get('reloj_modo') || 'real';\nconst offset = global.get('reloj_offset') || 0;\n\nconst ahora = Date.now() + (modo === 'simulado' ? offset : 0);\nconst d = new Date(ahora);\nconst pad = n => String(n).padStart(2, '0');\nconst hora = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());\n\n// Variables globales que leerán el resto de nodos\nglobal.set('reloj_ahora', ahora);\nglobal.set('reloj_hora', hora);\nglobal.set('reloj_tenue', d.getHours() >= 21);   // true de 21:00 a 23:59:59\n\n// Detección de eventos: se dispara si la hora del evento se ha cruzado\n// entre el tick anterior y este. Si hay un salto de hora (botones),\n// no se dispara nada.\nconst ultimo = context.get('ultimo');\ncontext.set('ultimo', ahora);\n\nconst eventos = [\n    { h: 21, m: 0, salida: 1, nombre: '21:00' },\n    { h: 0, m: 0, salida: 2, nombre: '00:00' },\n    { h: 8, m: 0, salida: 3, nombre: '08:00' }\n];\n\nconst out = [{ payload: hora }, null, null, null];\n\nif (ultimo !== undefined && ahora > ultimo && (ahora - ultimo) <= 5000) {\n    for (const e of eventos) {\n        const t = new Date(d.getFullYear(), d.getMonth(), d.getDate(), e.h, e.m, 0).getTime();\n        if (t > ultimo && t <= ahora) {\n            out[e.salida] = { payload: e.nombre };\n        }\n    }\n}\n\nreturn out;",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 160,
        "wires": [
