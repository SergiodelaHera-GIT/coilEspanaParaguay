        "z": "eb77ea0fe8cb6e59",
        "name": "REGULADOR",
        "func": "// REGULADOR (salon)\n// Entradas: temperatura, consigna, modo pedido por el usuario, ventana y eventos 00:00 / 08:00.\n// Salida 1 -> modo efectivo (off / auto)\n// Salida 2 -> accion (heating / cooling / idle / off)\nconst T = 'casa/salon/clima/';\nconst s = context.get('s') || { temp: null, consigna: 22, modoUsuario: 'off', ventana: false };\n\nswitch (msg.topic) {\n    case T + 'temperatura': {\n        const v = parseFloat(msg.payload);\n        if (!isNaN(v)) s.temp = v;\n        break;\n    }\n    case T + 'consigna': {\n        const v = parseFloat(msg.payload);\n        if (!isNaN(v)) s.consigna = v;\n        break;\n    }\n    case T + 'modo/set': {\n        const m = String(msg.payload);\n        if (m === 'off' || m === 'auto') s.modoUsuario = m;\n        break;\n    }\n    case 'casa/salon/ventana':\n        s.ventana = (String(msg.payload) === 'ON');   // ON = abierta\n        break;\n    default:\n        // Eventos de hora (llegan sin topic). A las 08:00 el regulador vuelve a estar activo.\n        // A las 00:00 solo se vuelve a evaluar (la noche se calcula con la hora del reloj).\n        if (msg.payload === '08:00') s.modoUsuario = 'auto';\n}\ncontext.set('s', s);\n\n// Noche = de 00:00 a 08:00 (hora del reloj virtual)\nconst ahora = global.get('reloj_ahora') || Date.now();\nconst noche = new Date(ahora).getHours() < 8;\n\n// Modo efectivo\nlet motivo = '';\nlet efectivo = s.modoUsuario;\nif (noche) { efectivo = 'off'; motivo = ' (noche)'; }\nelse if (s.ventana) { efectivo = 'off'; motivo = ' (ventana abierta)'; }\n\n// Accion\nlet accion = 'off';\nif (efectivo === 'auto') {\n    if (s.temp === null) accion = 'idle';\n    else if (s.temp < s.consigna - 0.5) accion = 'heating';\n    else if (s.temp > s.consigna + 0.5) accion = 'cooling';\n    else accion = 'idle';\n}\n\nnode.status({\n    fill: efectivo === 'auto' ? 'green' : 'grey',\n    shape: 'dot',\n    text: efectivo + ' / ' + accion + motivo\n});\n\nreturn [{ payload: efectivo }, { payload: accion }];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 3720,
        "wires": [
