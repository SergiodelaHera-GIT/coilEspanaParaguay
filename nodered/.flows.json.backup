    {
        "id": "d077e332d79dd633",
        "type": "function",
        "z": "eb77ea0fe8cb6e59",
        "name": "BRILLO (que varíe segun hora)",
        "func": "// BRILLO\n// Cuando una luz recibe ON, fija su brillo:\n//   tenue (50)    de 21:00 a 00:00  (variable global reloj_tenue = true)\n//   normal (255)  el resto del dia\nconst tenue = global.get('reloj_tenue') === true;\n\nreturn {\n    topic: msg.topic.replace(/\\/set$/, '/brillo/set'),\n    payload: String(tenue ? 50 : 255)\n};",
