    {
        "id": "18180aee8bb52d88",
        "type": "function",
        "z": "eb77ea0fe8cb6e59",
        "name": "QUITA /set",
        "func": "// QUITA /set\n// Convierte la orden en estado: casa/cocina/luz/set -> casa/cocina/luz\nconst topic = msg.topic.replace(/\\/set$/, '');\nlet payload = String(msg.payload);\n\n// Persianas: HA manda OPEN/CLOSE pero lee open/closed\nif (/^casa\\/[^/]+\\/persiana$/.test(topic)) {\n    if (payload === 'OPEN') payload = 'open';\n    else if (payload === 'CLOSE') payload = 'closed';\n}\n\nreturn { topic: topic, payload: payload };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 780,
        "wires": [
            [
                "1a0586031508624c"
            ]
        ]
    },
